{
  "expo": {
    "name": "Boxing Score",
    "slug": "boxing-score-companion",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/box-sc-icon--optimized.png",
    "scheme": "boxingscorecompanion",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gaddico.boxingscorecompanion",
      "infoPlist": {
        "CFBundleDisplayName": "Boxing Score"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "package": "com.gaddico.boxingscorecompanion"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/flatwhiteicon-optimized.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6228968095032196~7575749011",
          "iosAppId": "ca-app-pub-6228968095032196~8916102418"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
